# Samantha的衣橱 - 环境变量配置
# 复制此文件为 .env 并填入实际值

# Flask 密钥 (生产环境请生成随机字符串: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=change-me-to-a-random-string

# 应用版本
APP_VERSION=1.2.0

# 数据存储路径 (容器内使用 /app/data)
DATA_PATH=/app/data

# 持久化目录身份标识 (防止挂载到空目录)
# 首次安装后生成，之后切勿修改
EXPECTED_STORAGE_ID=

# 腾讯云 API 密钥 (可选，用于智能识别的服装类别检测)
TENCENT_SECRET_ID=your-secret-id
TENCENT_SECRET_KEY=your-secret-key
